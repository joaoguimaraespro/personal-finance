<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The desktop app (ADR-0010): a native window (system WebView via Photino) around the API running in the same
    process in desktop mode. Published self-contained per platform by the release workflow, next to the portable
    PostgreSQL (pgsql/) and the web build (web/).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PersonalFinance</AssemblyName>
    <RootNamespace>Host.Desktop</RootNamespace>
    <ApplicationIcon>../../../deploy/windows/personal-finance.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Host.Api/Host.Api.csproj" />
    <!-- The MCP server for AI clients runs in the same process too; aliased, since both hosts have a Program class. -->
    <ProjectReference Include="../Host.Mcp/Host.Mcp.csproj" Aliases="mcp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The API's defaults (logging levels, market data provider) when it runs inside the desktop app. -->
    <Content Include="../Host.Api/appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    Host.Api and Host.Mcp both bring an appsettings.json: the app keeps the API's (linked above) and the MCP server,
    which needs nothing from its own, reads the same file.
  -->
  <Target Name="KeepApiSettingsOnly" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <_McpSettings Include="@(ResolvedFileToPublish)"
                    Condition="$([System.String]::new('%(FullPath)').Contains('Host.Mcp')) And $([System.String]::new('%(Filename)').StartsWith('appsettings'))" />
      <ResolvedFileToPublish Remove="@(_McpSettings)" />
    </ItemGroup>
  </Target>
</Project>
