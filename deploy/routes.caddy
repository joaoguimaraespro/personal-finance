# Shared site configuration (security headers, /api, /mcp, SPA). Imported by Caddyfile and Caddyfile.local.
(site) {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Inline styles are required by Angular component styles and ECharts' SVG renderer; scripts are self-only.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	respond /healthz 200

	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:8080
	}

	# MCP (Streamable HTTP) for AI clients; authenticated per client token by the MCP host and the AI gateway.
	handle /mcp* {
		request_body {
			max_size 64KB
		}
		reverse_proxy mcp:8080
	}

	handle {
		root * /srv
		# Hashed build output only; the favicon keeps a stable name, so it must stay revalidatable.
		@immutable {
			path *.js *.css *.woff2 *.svg
			not path /favicon.svg
		}
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
