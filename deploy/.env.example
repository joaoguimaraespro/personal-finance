# Copy to .env (chmod 600). Never commit the real file.
# Generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-40

POSTGRES_SUPERUSER_PASSWORD=
FINANCE_MIGRATOR_PASSWORD=
FINANCE_APP_PASSWORD=
FINANCE_BACKUP_PASSWORD=

# One-time token to create the owner account at first run (min 24 chars). Rotate or blank it afterwards.
AUTH_SETUP_TOKEN=

# Where the web container listens on the host. Keep loopback and put `tailscale serve` in front of it.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Demo broker with fictitious data (demos / CI only).
INTEGRATIONS_ENABLE_DEMO=false

# Optional: OpenTelemetry collector (the app runs fine without it).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: pin images instead of building locally.
# API_IMAGE=ghcr.io/joaoguimaraespro/personal-finance-api:1.0.0
# WEB_IMAGE=ghcr.io/joaoguimaraespro/personal-finance-web:1.0.0
# MCP_IMAGE=ghcr.io/joaoguimaraespro/personal-finance-mcp:1.0.0

# Backups (see docs/disaster-recovery.md). The public key encrypts; the private key never lives on this server.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/home/finance/personal-finance/backups
BACKUP_RETENTION_DAYS=35

# Optional in-app assistant (Claude API). Empty = disabled. Questions and the minimal tool results go to Anthropic.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
