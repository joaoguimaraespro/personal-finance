{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "mcp__personal-finance__*",
      "Skill(resumo-mes)",
      "Skill(revisao-anual)",
      "Skill(carteira)",
      "Skill(patrimonio)",
      "Skill(orcamento)",
      "Skill(gastos)",
      "Skill(objetivos)",
      "Skill(check-in)"
    ],
    "ask": [
      "mcp__personal-finance__create_transaction",
      "mcp__personal-finance__update_transaction",
      "mcp__personal-finance__delete_transaction",
      "mcp__personal-finance__confirm_expected",
      "mcp__personal-finance__skip_expected",
      "mcp__personal-finance__upsert_recurring",
