#!/usr/bin/env python3
# armature-hook: pre-commit (installed by the core plugin's bin/install-hooks.sh; safe to overwrite)
"""pre-commit hook: keep env files, data files, secrets and denylisted org names out of commits.

Blocks staged (added, copied, modified or renamed) files that are:
  env_file     .env or .env.* (templates ending in .example, .sample or .template are allowed)
  data_file    .xlsx .xls .csv .parquet outside the allow-list: mock/, tests/fixtures/ (at any depth) and each
               line of the repo's .armature/allow-data (a path prefix ending in '/', or a glob)
  secret       a common secret pattern on an added line (private keys, cloud and git host tokens, API keys,
               password assignments, credentials in URLs). A line containing 'pragma: allowlist secret' is skipped.
  denylist     a name from the file in $ARMATURE_DENYLIST (one per line, '#' comments) in a path or added line,
               matched case-insensitively as a whole word. Unset: skipped. The file must live outside the repo.
               Findings name the denylist line number, never the name itself.

Output: JSON {"ok", "violations": [{"file", "line", "kind", "detail"}]} on stdout, hints on stderr.
Exit: 0 ok, 1 blocked, 2 usage or setup error.
"""
import fnmatch
import json
import os
import re
import subprocess
import sys

DATA_EXT = (".xlsx", ".xls", ".csv", ".parquet")
DEFAULT_ALLOW = ["mock/", "tests/fixtures/", "*/tests/fixtures/*"]
ENV_TEMPLATE = (".example", ".sample", ".template")
ALLOW_SECRET = "pragma: allowlist secret"
SECRETS = [
    (re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----"), "private key"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "AWS access key id"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b"), "GitHub token"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{22,}\b"), "GitHub fine-grained token"),
    (re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}\b"), "GitLab token"),
    (re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}\b"), "Slack token"),
    (re.compile(r"\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}\b"), "API secret key (sk-...)"),
    (re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b"), "Google API key"),
    (re.compile(r"\blin_(?:api|oauth)_[A-Za-z0-9]{20,}\b"), "Linear API key"),
    (re.compile(r"AccountKey=[A-Za-z0-9+/=]{40,}"), "Azure storage account key"),
    (re.compile(r"SharedAccessSignature=|[?&]sig=[A-Za-z0-9%+/=]{20,}"), "Azure SAS token"),
    (re.compile(r"""(?i)\b(?:password|passwd|pwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)\b"""
                r"""\s*[:=]\s*['"][^'"\s$<{]{8,}['"]"""), "hard-coded credential"),
    (re.compile(r"\b[a-z][a-z0-9+.-]*://[^/\s:@'\"]+:([^@\s/'\"]{3,})@([^/\s:'\"]+)"), "credentials in a URL"),
]
URL_SAFE_HOSTS = ("localhost", "127.0.0.1", "0.0.0.0", "example.com", "example.org")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, check=True).stdout


def staged_files():
    out = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").decode("utf-8", "replace")
    return [p for p in out.split("\0") if p]


def added_lines(path):
    out = git("diff", "--cached", "-U0", "--no-color", "--no-ext-diff", "--", path)
    if b"\0" in out or b"Binary files" in out:
        return []
    lines, ln = [], 0
    for raw in out.decode("utf-8", "replace").splitlines():
        if raw.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", raw)
            ln = int(m.group(1)) if m else 0
        elif raw.startswith("+") and not raw.startswith("+++"):
            lines.append((ln, raw[1:]))
            ln += 1
    return lines


def allow_list(root):
    allow = list(DEFAULT_ALLOW)
    path = os.path.join(root, ".armature", "allow-data")
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as fh:
            allow += [l.strip() for l in fh if l.strip() and not l.lstrip().startswith("#")]
    return allow


def data_allowed(path, allow):
    for entry in allow:
        if entry.endswith("/") and path.startswith(entry):
            return True
        if fnmatch.fnmatch(path, entry):
            return True
    return False


def is_env_file(path):
    base = os.path.basename(path)
    if base != ".env" and not base.startswith(".env."):
        return False
    return not base.endswith(ENV_TEMPLATE)


def load_denylist(root):
    path = os.environ.get("ARMATURE_DENYLIST")
    if not path:
        return [], None
    real = os.path.realpath(os.path.expanduser(path))
    if real == root or real.startswith(root + os.sep):
        return None, "ARMATURE_DENYLIST points inside this repo; keep the denylist outside any repo"
    try:
        with open(real, encoding="utf-8") as fh:
            names = [(i, l.strip()) for i, l in enumerate(fh, 1) if l.strip() and not l.lstrip().startswith("#")]
    except OSError as e:
        return None, f"cannot read ARMATURE_DENYLIST: {e}"
    return [(i, re.compile(r"(?<![A-Za-z0-9])" + re.escape(n) + r"(?![A-Za-z0-9])", re.I)) for i, n in names], None


def secret_hit(text):
    if ALLOW_SECRET in text:
        return None
    for rx, label in SECRETS:
        m = rx.search(text)
        if not m:
            continue
        if label == "credentials in a URL":
            pw, host = m.group(1), m.group(2).lower()
            if host in URL_SAFE_HOSTS or pw.startswith(("$", "<", "{", "*")) or host.endswith(".example.com"):
                continue
        return label
    return None


def main(argv):
    if len(argv) > 1:
        print("usage: pre-commit (run by git, no arguments)", file=sys.stderr)
        return 2
    try:
        root = os.path.realpath(git("rev-parse", "--show-toplevel").decode().strip())
        os.chdir(root)
        files = staged_files()
    except (OSError, subprocess.CalledProcessError) as e:
        print(f"pre-commit: not in a git repo: {e}", file=sys.stderr)
        return 2
    deny, err = load_denylist(root)
    if err:
        print(json.dumps({"ok": False, "violations": [], "error": err}))
        print(f"pre-commit: {err}", file=sys.stderr)
        return 2
    allow = allow_list(root)
    violations = []
    for path in files:
        if is_env_file(path):
            violations.append({"file": path, "line": 0, "kind": "env_file", "detail": "env files stay out of git"})
            continue
        if path.lower().endswith(DATA_EXT) and not data_allowed(path, allow):
            violations.append({"file": path, "line": 0, "kind": "data_file",
                               "detail": "data file outside mock/, tests/fixtures/ and .armature/allow-data"})
        for i, rx in deny:
            if rx.search(path):
                violations.append({"file": path, "line": 0, "kind": "denylist", "detail": f"denylist entry {i} in path"})
        for ln, text in added_lines(path):
            label = secret_hit(text)
            if label:
                violations.append({"file": path, "line": ln, "kind": "secret", "detail": label})
            for i, rx in deny:
                if rx.search(text):
                    violations.append({"file": path, "line": ln, "kind": "denylist", "detail": f"denylist entry {i}"})
    print(json.dumps({"ok": not violations, "violations": violations}))
    for v in violations:
        where = f"{v['file']}:{v['line']}" if v["line"] else v["file"]
        print(f"pre-commit: {v['kind']}: {where}: {v['detail']}", file=sys.stderr)
    if violations:
        print("pre-commit: unstage these (git restore --staged <file>) or fix them. Data that must be committed "
              "goes in .armature/allow-data.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
