# Config for ~/Development/nexus/scripts/agent-loop.sh (one fresh agent per Spec Kit task).
# The loop marks a task done only when VERIFY_CMD exits 0.

# Local gate: build + every backend test project except Integration.Tests (needs Docker), then web tests and format.
VERIFY_CMD='set -e
cd backend && dotnet build --nologo -v q
for p in tests/*.Tests; do case "$p" in */Integration.Tests) continue ;; esac; dotnet test --project "$p" --no-build; done
cd ../web && npm test && npm run lint:format'

SETUP_CMD='cd web && npm ci --no-audit --no-fund'

CLAUDE_ALLOWED_TOOLS='Read,Edit,Write,Glob,Grep,Task,Bash(dotnet build:*),Bash(dotnet test:*),Bash(dotnet format:*),Bash(dotnet ef:*),Bash(npm test:*),Bash(npm run:*),Bash(npx prettier:*),Bash(git status:*),Bash(git diff:*),Bash(ls:*)'
