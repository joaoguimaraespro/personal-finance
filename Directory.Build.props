<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1848/CA1873: LoggerMessage delegates are overkill here; CA1515: minimal-API types are public by design;
         CA1862: EF Core translates ToLower().Contains() to SQL, the StringComparison overload does not translate -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1515;CA1711;CA1716;CA1062;CA2007;CA1031;CA1805;CA1720;CA1724;CA1034;CA1819;CA1056;CA1054;CA1055;CA2227;CA1002;CA1308;CA1812;CA1861;CA1307;CA1310;CA1305;CA1304;CA1311;CA2201;CA1822;CA1862</NoWarn>
  </PropertyGroup>
</Project>
